rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  	
    function isAdmin(userEmail) {
      return (userEmail == "zhougj7@hotmail.com" 
      || userEmail == "lijianhua67@hotmail.com"
      || userEmail == "syga2029@gmail.com"
      || userEmail == "hzslmc@gmail.com"
      || userEmail == "support@internationalbuddy.org"
      || userEmail == "internationalbuddyweb@gmail.com"
      || userEmail == "cadencel2019@outlook.com"
      || userEmail == "kaicheng.bear@gmail.com");
    }
  
    match /{document=**} {
      allow read, write: if false;
    }
    match /autism_documents/{docID} {
      allow read;
    }
    match /users/{docID} {
      allow read;
      allow create: if request.auth != null;
      allow update: if request.auth != null && 
				(request.auth.token.email == docID
        || request.auth.token.email + "_1" == docID
        || request.auth.token.email + "_2" == docID
        || request.auth.token.email + "_3" == docID
        || request.auth.token.email + "_4" == docID
        || isAdmin(request.auth.token.email));
    }
    match /users/{docID}/services/{doc2ID} {
      allow read;
      allow write: if request.auth != null && 				
        (request.auth.token.email == docID
        || request.auth.token.email + "_1" == docID
        || request.auth.token.email + "_2" == docID
        || request.auth.token.email + "_3" == docID
        || request.auth.token.email + "_4" == docID
        || isAdmin(request.auth.token.email));
    }
    match /app_admin/{docID} {
      allow read: if request.auth != null && request.auth.token.email == docID;
    }
    match /event_records/{docID} {
      allow read;
      allow create: if request.auth != null && isAdmin(request.auth.token.email);
    }
    match /event_upcomings/{docID} {
      allow read;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null && isAdmin(request.auth.token.email);
    }
    match /mail/{docID} {
    	allow read, create;
    }
    match /weekly_template/{docID} {
    	allow read;
      allow write: if request.auth != null && isAdmin(request.auth.token.email);
    }
    match /specialolympics_team/{docID} {
    	allow read, create: if request.auth != null;
      allow update, delete: if request.auth != null && isAdmin(request.auth.token.email);
    }
    match /art_gallery/{docID} {
    	allow read;
    }
  }
}