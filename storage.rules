rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
    match /autism_documents/{pathID} {
      allow read;
    }
    match /legal_documents/{pathID} {
      allow read;
    }
    match /event_records/{pathID} {
      allow read, write: if request.auth != null;
    }
    match /event_upcomings/{pathID} {
      allow read, write: if request.auth != null;
    }
    match /what_we_do/{pathID} {
    	allow read;
    }
    match /ourteam/{pathID} {
    	allow read;
    }
    match /specialolympics_team/{pathID} {
      allow read;
      allow write: if request.auth != null;
    }
  }
}